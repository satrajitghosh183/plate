# Local development. Copy to .env and fill in; never commit .env.
DATABASE_URL=
APP_URL=http://localhost:8080
PUBLIC_URL=http://localhost:8080
SETUP_CODE=
# 64 hex characters (openssl rand -hex 32) or base64 of 32 bytes
TOKEN_KEY=
STATIC_DIR=dist
# Only for `scripts/plate.sh authorize strava|spotify`. They are then stored encrypted in
# the database, so Render never needs them.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Only for `scripts/plate.sh login google`. Stored sealed in the database afterwards.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
